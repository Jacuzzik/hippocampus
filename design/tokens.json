      "mdiff-coral": { "$value": "#E08C82" },
      "mdiff-orange": { "$value": "#E8924A" },
      "mdiff-green": { "$value": "#7BC47F" },
      "mdiff-lilac": { "$value": "#A896E3" },
      "mdpal-paper-100": { "$value": "#1A1A1F" },
      "mdpal-paper-200": { "$value": "#222229" },
      "mdpal-ink-900": { "$value": "#DEDBD6" },
      "mdpal-ink-500": { "$value": "#96919F" },
      "mdpal-ink-300": { "$value": "#787684" },
      "mdpal-ink-on-accent": { "$value": "#1A1320" },
      "mdpal-lilac": { "$value": "#9482D3" },
