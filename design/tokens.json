{
  "$description": "Hippocampus design tokens. Dark theme only for v1. Surfaces, borders and text use Obsidian's default dark theme; accent, think, confirm, danger, focus ring and radii come from the Munder Difflin app's dark tokens. Semantic colors are checked for contrast on bg-0 and bg-1.",
  "color": {
    "primitive": {
      "obsidian-bg-1": { "$value": "#1C1C1C" },
      "obsidian-bg-2": { "$value": "#212121" },
      "obsidian-border": { "$value": "#333333" },
      "obsidian-text": { "$value": "#DADADA" },
      "obsidian-muted": { "$value": "#999999" },
      "obsidian-faint": { "$value": "#8C8C8C" },
      "obsidian-accent": { "$value": "#6A58E0" },
      "mdiff-lemon": { "$value": "#E2CC55" },
      "mdiff-coral": { "$value": "#E08C82" },
      "mdiff-lilac": { "$value": "#A896E3" },
      "white": { "$value": "#FFFFFF" }
    },
    "semantic": {
      "bg-0": { "$value": "{color.primitive.obsidian-bg-1}" },
      "bg-1": { "$value": "{color.primitive.obsidian-bg-2}" },
      "border": { "$value": "{color.primitive.obsidian-border}" },
      "surface": { "$value": "rgba(255, 255, 255, 0.06)" },
      "accent": { "$value": "{color.primitive.obsidian-accent}" },
      "accent-on": { "$value": "{color.primitive.white}" },
      "focus-ring": { "$value": "rgba(226, 204, 85, 0.55)" },
      "think": { "$value": "{color.primitive.mdiff-lilac}" },
      "link": { "$value": "{color.primitive.mdiff-lilac}" },
      "confirm": { "$value": "{color.primitive.mdiff-lemon}" },
      "danger": { "$value": "{color.primitive.mdiff-coral}" },
      "text": { "$value": "{color.primitive.obsidian-text}" },
      "text-muted": { "$value": "{color.primitive.obsidian-muted}" },
      "text-subtle": { "$value": "{color.primitive.obsidian-faint}" }
    }
  },
  "space": {
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" }
  },
  "radius": {
    "sm": { "$value": "6px" },
    "md": { "$value": "8px" }
  },
  "font-size": {
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "20px" }
  },
  "layout": {
    "topbar-height": { "$value": "44px" },
    "left-rail-width": { "$value": "56px" },
    "right-panel-width": { "$value": "360px" },
    "window-min-width": { "$value": "960px" },
    "window-min-height": { "$value": "600px" }
  },
  "contrast_checks": {
    "text on bg-0": "AA pass (see app/scripts/contrast.test.mjs)",
    "text-muted on bg-0": "AA pass (see app/scripts/contrast.test.mjs)",
    "text-subtle on bg-1": "AA pass for normal text (see app/scripts/contrast.test.mjs)",
    "accent-on on accent": "AA pass for normal text (see app/scripts/contrast.test.mjs)",
    "confirm on bg-1": "AA non-text 3:1 pass (see app/scripts/contrast.test.mjs)",
    "danger on bg-1": "AA pass (see app/scripts/contrast.test.mjs)",
    "link on bg-0": "use for graph edges and icons only, not small text"
  },
  "font": {
    "ui": "Inter (fallback: system-ui, -apple-system, \"Segoe UI\", sans-serif)",
    "mono": "JetBrains Mono (fallback: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace)"
  },
  "motion": {
    "respect": "prefers-reduced-motion disables orb swirl and graph drift"
  }
}
