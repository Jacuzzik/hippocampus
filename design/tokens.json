{
  "$description": "Hippocampus design tokens. Dark theme only for v1. Palette colors sampled from the reference strip; semantic colors chosen for contrast on bg-0.",
  "color": {
    "primitive": {
      "violet-900": { "$value": "#0E0234" },
      "violet-800": { "$value": "#39116A" },
      "violet-700": { "$value": "#4C1B84" },
      "violet-500": { "$value": "#8424E0" },
      "violet-400": { "$value": "#A536EC" },
      "amber-400":  { "$value": "#F5A524" },
      "red-400":    { "$value": "#FF5A4E" },
      "white":      { "$value": "#FFFFFF" },
      "ink-50":     { "$value": "#F4F0FA" },
      "ink-300":    { "$value": "#B9A9D6" },
      "ink-400":    { "$value": "#8E7DB0" }
    },
    "semantic": {
      "bg-0":        { "$value": "{color.primitive.violet-900}" },
      "bg-1":        { "$value": "{color.primitive.violet-800}" },
      "border":      { "$value": "{color.primitive.violet-700}" },
      "surface":     { "$value": "rgba(76, 27, 132, 0.35)" },
      "accent":      { "$value": "{color.primitive.violet-500}" },
      "accent-on":   { "$value": "{color.primitive.white}" },
      "think":       { "$value": "{color.primitive.violet-400}" },
      "link":        { "$value": "{color.primitive.violet-400}" },
      "confirm":     { "$value": "{color.primitive.amber-400}" },
      "danger":      { "$value": "{color.primitive.red-400}" },
      "text":        { "$value": "{color.primitive.ink-50}" },
      "text-muted":  { "$value": "{color.primitive.ink-300}" },
      "text-subtle": { "$value": "{color.primitive.ink-400}" }
    }
  },
  "space": {
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" }
  },
  "radius": {
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" }
  },
  "font-size": {
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "20px" }
  },
  "layout": {
    "topbar-height":     { "$value": "44px" },
    "left-rail-width":   { "$value": "56px" },
    "right-panel-width": { "$value": "360px" },
    "window-min-width":  { "$value": "960px" },
    "window-min-height": { "$value": "600px" }
  },
  "contrast_checks": {
    "text on bg-0": "17.4:1 (AA and AAA pass)",
    "text-muted on bg-0": "9.0:1 (AA pass)",
    "text-subtle on bg-0": "5.3:1 (AA pass for normal text)",
    "accent-on on accent": "6.3:1 (AA pass for normal text)",
    "confirm on bg-0": "9.6:1 (AA pass)",
    "danger on bg-0": "6.3:1 (AA pass)",
    "link on bg-0": "4.0:1 (use for graph edges and icons only, not small text)"
  },
  "font": {
    "ui": "Outfit (fallback: system-ui, sans-serif)",
    "mono": "JetBrains Mono (fallback: ui-monospace, monospace)"
  },
  "motion": {
    "respect": "prefers-reduced-motion disables orb swirl and graph drift"
  }
}
