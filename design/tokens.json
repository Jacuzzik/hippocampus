    "semantic": {
      "bg-0": { "$value": "{color.primitive.base-bg-1}" },
      "bg-1": { "$value": "{color.primitive.base-bg-2}" },
      "border": { "$value": "{color.primitive.base-border}" },
      "surface": { "$value": "rgba(255, 255, 255, 0.06)" },
      "md-bg-0": { "$value": "{color.primitive.mdpal-paper-200}" },
      "md-bg-1": { "$value": "{color.primitive.mdpal-paper-100}" },
      "md-surface": { "$value": "{color.primitive.mdpal-paper-200}" },
      "md-text": { "$value": "{color.primitive.mdpal-ink-900}" },
      "md-text-muted": { "$value": "{color.primitive.mdpal-ink-500}" },
      "md-text-subtle": { "$value": "{color.primitive.mdpal-ink-300}" },
