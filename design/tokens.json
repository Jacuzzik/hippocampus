      "text-muted": { "$value": "{color.primitive.base-muted}" },
      "text-subtle": { "$value": "{color.primitive.base-faint}" },
      "face-disc": { "$value": "{color.primitive.white}" },
      "graph-1": { "$value": "#A896E3" },
      "graph-2": { "$value": "#E2CC55" },
      "graph-3": { "$value": "#8B7CF0" },
      "graph-4": { "$value": "#7FC4E8" },
